---
const path = Astro.url.pathname;
const links = [
  { href: '/work/', label: 'Work' },
  { href: '/#method', label: 'Method' },
  { href: '/#capabilities', label: 'Capabilities' },
  { href: '/#contact', label: 'Contact' },
];
const isCurrent = (href: string) => href === '/work/' && path.startsWith('/work/');
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href="/">
      <span class="brand__name">Kolawole Odewusi</span>
      <span class="brand__role mono">BA · AI Evaluation</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul id="nav-list" class="nav__list" data-nav-list>
        {links.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="tools">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch colour theme">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"/></svg>
      </button>
      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="nav-list">
        <span class="visually-hidden">Menu</span>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px); border-bottom: 1px solid transparent; transition: border-color .2s ease;
  }
  .site-header.is-scrolled { border-bottom-color: var(--rule); }
  .bar { display: flex; align-items: center; gap: var(--s-5); min-height: 72px; transition: min-height .2s ease; }
  .is-scrolled .bar { min-height: 60px; }
  .brand { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); margin-right: auto; line-height: 1.2; }
  .brand__name { font-family: var(--font-display); font-size: 1.25rem; font-weight: 500; }
  .brand__role { font-size: 0.72rem; color: var(--ink-2); letter-spacing: 0.04em; text-transform: uppercase; }
  .nav__list { display: flex; gap: var(--s-5); list-style: none; margin: 0; padding: 0; }
  .nav__list li + li { margin: 0; }
  .nav__list a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); text-decoration: none; font-weight: 500; font-size: var(--step--1); border-bottom: 1px solid transparent; }
  .nav__list a:hover, .nav__list a[aria-current='page'] { border-bottom-color: var(--cobalt); color: var(--cobalt); }
  .tools { display: flex; gap: var(--s-1); }
  .icon-btn { display: grid; place-items: center; width: 44px; height: 44px; background: none; border: 0; color: var(--ink); cursor: pointer; border-radius: var(--radius); }
  .icon-btn:hover { background: var(--paper-2); }
  .menu-btn { display: none; }
  .progress { height: 2px; }
  .progress span { display: block; height: 100%; width: 0; background: var(--cobalt-mark); }

  @media (max-width: 760px) {
    .menu-btn { display: grid; }
    .nav { order: 3; }
    .nav__list {
      display: none; position: fixed; inset: 60px 0 auto 0; flex-direction: column; gap: 0;
      background: var(--paper); border-bottom: 1px solid var(--rule); padding: var(--s-3) var(--gutter) var(--s-5);
    }
    .nav__list.is-open { display: flex; }
    .nav__list a { width: 100%; font-size: var(--step-1); font-family: var(--font-display); border-bottom: 1px solid var(--rule); padding-block: var(--s-3); }
  }
</style>
