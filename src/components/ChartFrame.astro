---
// Wraps a chart with its provenance label, caption and a data-table view.
import Source from './Source.astro';

interface Props {
  kind: 'recreated' | 'calculated';
  source: string;
  head: string[];
  rows: (string | number)[][];
  numeric?: number[];
}
const { kind, source, head, rows, numeric = [] } = Astro.props;
---
<figure class="chartframe">
  <slot />
  <figcaption>
    <Source kind={kind}>{source}</Source>
    <slot name="caption" />
  </figcaption>
  <details class="data">
    <summary>View data table</summary>
    <div class="table-scroll">
      <table>
        <thead><tr>{head.map((h, i) => <th scope="col" class={numeric.includes(i) ? 'num' : undefined}>{h}</th>)}</tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>{r.map((c, i) => (i === 0 ? <th scope="row">{c}</th> : <td class={numeric.includes(i) ? 'num' : undefined}>{c}</td>))}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .chartframe { margin: var(--s-6) 0; padding: var(--s-5); border: 1px solid var(--rule); border-radius: var(--radius); background: color-mix(in srgb, var(--paper-2) 45%, var(--paper)); }
  figcaption { margin-top: var(--s-4); font-size: var(--step--1); color: var(--ink-2); }
  figcaption :global(p) { margin: var(--s-2) 0 0; }
  @media (max-width: 560px) { .chartframe { padding: var(--s-4) var(--s-3); } }
</style>
