---
// An original project screenshot: optimised responsive image, click to enlarge, caption and
// an explicit "Original screenshot" source label so it is never confused with a recreated chart.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Source from './Source.astro';

interface Props { src: ImageMetadata; alt: string; eager?: boolean; source?: string }
const { src, alt, eager = false, source = 'Original Power BI screenshot' } = Astro.props;
const full = await getImage({ src, format: 'webp', width: src.width, quality: 90 });
---
<figure class="shot">
  <a href={full.src} data-zoom aria-label={`Enlarge: ${alt}`}>
    <Image src={src} alt={alt} widths={[640, 960, src.width]} sizes="(min-width: 1100px) 860px, 100vw"
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  </a>
  <figcaption>
    <Source kind="screenshot">{source}</Source>
    <slot />
  </figcaption>
</figure>

<style>
  .shot { margin: var(--s-6) 0; }
  .shot a { display: block; border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; cursor: zoom-in; background: var(--paper-2); }
  .shot a:hover { border-color: var(--rule-strong); }
  figcaption { margin-top: var(--s-3); font-size: var(--step--1); color: var(--ink-2); max-width: var(--measure); }
  figcaption :global(p) { margin: var(--s-2) 0 0; }
</style>
