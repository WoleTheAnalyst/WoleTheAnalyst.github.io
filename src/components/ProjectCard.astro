---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import StatusBadge from './StatusBadge.astro';
import type { Project } from '../data/projects';

interface Props { project: Project; image: ImageMetadata; feature?: boolean }
const { project, image, feature = false } = Astro.props;
const href = `/work/${project.slug}/`;
---
<article class:list={['card', { feature }]}>
  <a class="card__media" href={href} tabindex="-1" aria-hidden="true">
    <Image src={image} alt="" widths={[480, 800, 1200]} sizes={feature ? '(min-width: 1000px) 700px, 100vw' : '(min-width: 1000px) 480px, 100vw'} loading="lazy" />
    <span class="card__reveal">
      <span class="mono small">The question</span>
      <span>{project.question}</span>
    </span>
  </a>
  <div class="card__body">
    <p class="meta"><StatusBadge status={project.status} /> <span class="mono small muted">{project.disciplines.join(' · ')}</span></p>
    <h3><a href={href}>{project.title}</a></h3>
    <p class="small muted">{project.summary}</p>
    <p class="tools mono">{project.tools.join(' · ')} · <span>{project.context}</span></p>
  </div>
</article>

<style>
  .card { grid-column: span 5; display: flex; flex-direction: column; gap: var(--s-4); position: relative; }
  .card.feature { grid-column: span 7; }
  .card__media { position: relative; display: block; border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; background: var(--paper-2); aspect-ratio: 16 / 9; }
  .card__media img { width: 100%; height: 100%; object-fit: cover; object-position: top left; transition: transform .4s ease; }
  .card__reveal {
    position: absolute; inset: auto 0 0 0; display: grid; gap: var(--s-1); padding: var(--s-4); background: var(--ink); color: var(--paper);
    font-family: var(--font-display); font-size: var(--step-1); line-height: 1.3; transform: translateY(101%); transition: transform .3s ease;
  }
  .card__reveal .mono { font-family: var(--font-mono); color: color-mix(in srgb, var(--paper) 70%, transparent); text-transform: uppercase; letter-spacing: .05em; font-size: 0.72rem; }
  .card:hover .card__reveal, .card:focus-within .card__reveal { transform: none; }
  .card:hover .card__media img { transform: scale(1.02); }
  .meta { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: baseline; margin: 0; }
  h3 { font-family: var(--font-display); font-weight: 500; font-size: var(--step-2); line-height: 1.15; margin: 0; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  h3 a:hover { color: var(--cobalt); }
  h3 a:focus-visible { outline: none; }
  .card:has(h3 a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 6px; }
  .tools { font-size: 0.75rem; color: var(--ink-2); margin: 0; }
  @media (max-width: 1000px) { .card, .card.feature { grid-column: 1 / -1; } }
</style>
