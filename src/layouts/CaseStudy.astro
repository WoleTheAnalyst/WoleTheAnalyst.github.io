---
import Base from './Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  description: string;
  toc: { id: string; label: string }[];
  facts: { term: string; detail: string }[];
  ogImage?: string;
}
const { project, description, toc, facts, ogImage } = Astro.props;
---
<Base title={project.title} description={description} type="article" ogImage={ogImage}>
  <article>
    <header class="cs-head wrap">
      <p class="eyebrow"><a href="/work/">Work</a> / {project.disciplines.join(' · ')}</p>
      <h1>{project.title}</h1>
      <p class="lede">{project.summary}</p>
      <dl class="facts">
        <div><dt>Status</dt><dd><StatusBadge status={project.status} /></dd></div>
        <div><dt>Context</dt><dd>{project.context}</dd></div>
        <div><dt>Tools</dt><dd>{project.tools.join(', ')}</dd></div>
        <div><dt>Period</dt><dd>{project.period}</dd></div>
        {facts.map((f) => <div><dt>{f.term}</dt><dd>{f.detail}</dd></div>)}
      </dl>
    </header>

    <div class="cs-body wrap">
      <nav class="toc" aria-label="On this page" data-toc>
        <p class="eyebrow">On this page</p>
        <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
      </nav>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .cs-head { padding-block: var(--s-8) var(--s-7); border-bottom: 1px solid var(--rule); }
  .cs-head h1 { max-width: 20ch; }
  .eyebrow a { color: inherit; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--s-4) var(--s-6); margin: var(--s-6) 0 0; padding-top: var(--s-5); border-top: 1px solid var(--rule); }
  .facts dt { font: 500 0.72rem/1.4 var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-2); }
  .facts dd { margin: var(--s-1) 0 0; font-size: var(--step--1); }
  .cs-body { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: var(--s-8); padding-block: var(--s-7) var(--s-9); }
  .toc { position: sticky; top: 96px; align-self: start; font-size: var(--step--1); }
  .toc ol { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--rule); }
  .toc li { margin: 0; }
  .toc a { display: block; padding: 6px 0 6px var(--s-4); margin-left: -1px; border-left: 2px solid transparent; color: var(--ink-2); text-decoration: none; line-height: 1.35; }
  .toc a:hover { color: var(--ink); }
  .toc a[aria-current] { color: var(--cobalt); border-left-color: var(--cobalt-mark); }
  .prose { max-width: 860px; }
  .prose :global(section) { padding-top: var(--s-7); }
  .prose :global(section:first-child) { padding-top: 0; }
  .prose :global(section > h2) { font-size: var(--step-2); padding-top: var(--s-5); border-top: 1px solid var(--rule); }
  .prose :global(h3) { margin-top: var(--s-6); }
  @media (max-width: 960px) {
    .cs-body { grid-template-columns: 1fr; gap: var(--s-5); }
    .toc { position: static; border: 1px solid var(--rule); padding: var(--s-4); }
  }
</style>
